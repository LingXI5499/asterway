# 复制为 agent/.env，只在 .env 中填写真实配置；从 agent 目录启动 run.py。
APP_NAME=Asterway Agent
APP_ENV=local
AGENT_PORT=8001
JAVA_API_BASE_URL=http://127.0.0.1:8089

# 服务间密钥：自己生成 32～128 位安全字符，与 Java 的 asterway.agent.internal-key 完全一致。
# 这是内部校验密钥，与模型供应商提供的 API Key 分开配置。
AGENT_INTERNAL_KEY=

# 聊天服务：替换基础地址与模型 ID，并填写供应商提供的 API Key。
# 基础地址是否带 /v1 以供应商说明为准，不要填写完整的 /chat/completions 地址。
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=your-chat-model
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60

# Agent 使用独立角色，连接与 Java 相同的 PostgreSQL 数据库。
# 用实际主机、数据库、角色和密码替换下面格式；密码中特殊字符需做 URL 编码。
# AGENT_DATABASE_URL=postgresql+asyncpg://agent_user:your_url_encoded_password@127.0.0.1:5432/asterway_dev
AGENT_DATABASE_URL=
AGENT_DB_POOL_SIZE=5
AGENT_DB_MAX_OVERFLOW=5

# 向量服务：可与聊天使用不同供应商；保持与数据库一致的 1024 维。
# 基础地址不填写完整的 /embeddings 路径。
EMBEDDING_BASE_URL=https://api.example.com/v1
EMBEDDING_MODEL=your-embedding-model
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=30

# 单轮、规划和业务工具预算。
AGENT_TURN_TIMEOUT_SECONDS=240
AGENT_REQUEST_TIMEOUT_SECONDS=240
AGENT_PARTIAL_SAVE_INTERVAL_SECONDS=2
AGENT_CONTEXT_RECENT_MESSAGES=20
AGENT_CONTEXT_MAX_CHARS=24000
AGENT_SUMMARY_TRIGGER_MESSAGES=16
AGENT_SUMMARY_KEEP_MESSAGES=8
AGENT_SUMMARY_MAX_CHARS=8000
AGENT_TOOLS_ENABLED=true
AGENT_TOOL_MAX_ROUNDS=5
AGENT_TOOL_MAX_CALLS=12
AGENT_TOOL_TIMEOUT_SECONDS=8
AGENT_TOOL_MAX_RESULT_CHARS=12000
AGENT_REVIEW_WAIT_SECONDS=35
AGENT_PLANNING_MAX_OUTPUT_TOKENS=8192
AGENT_WORKFLOW_TTL_SECONDS=900

# 知识文件只保存在本地受控目录。上传能力接口给出的有效上限最高 25 MB。
AGENT_KNOWLEDGE_DIR=data/knowledge
AGENT_KNOWLEDGE_MAX_BYTES=26214400
AGENT_KNOWLEDGE_EMBEDDING_BATCH=10
