        <maven.compiler.release>17</maven.compiler.release>
        <!-- 设置 project.build.sourceEncoding 对应的工程或映射参数。 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 设置 project.reporting.outputEncoding 对应的工程或映射参数。 -->
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- 设置 mybatis-starter.version 对应的工程或映射参数。 -->
        <mybatis-starter.version>3.0.5</mybatis-starter.version>
        <!-- 设置 springdoc.version 对应的工程或映射参数。 -->
        <springdoc.version>2.8.17</springdoc.version>
        <!-- 设置 bouncycastle.version 对应的工程或映射参数。 -->
        <bouncycastle.version>1.80</bouncycastle.version>
    </properties>
