<?xml version="1.0" encoding="UTF-8"?><!-- 声明 Maven 模块、依赖和编译打包规则，供导入工程及构建时使用。 -->
<!-- 声明这个 Maven 工程的整体配置。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- 声明 POM 使用的模型格式版本。 -->
    <modelVersion>4.0.0</modelVersion>
    <!-- 从指定父工程继承统一版本和构建规则。 -->
    <parent>
        <!-- 声明依赖或工程所属组织标识。 -->
        <groupId>com.asterway</groupId>
        <!-- 声明当前工程、依赖或插件的名称。 -->
        <artifactId>asterway-backend</artifactId>
        <!-- 指定使用的版本号。 -->
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <!-- 声明当前工程、依赖或插件的名称。 -->
    <artifactId>common</artifactId>
    <!-- 设置 name 对应的工程或映射参数。 -->
    <name>asterway-common</name>
    <!-- 设置 description 对应的工程或映射参数。 -->
    <description>公共配置、统一结果、异常、安全、JWT 与 Redis 基础能力。</description>
    <!-- 列出当前模块实际需要的依赖。 -->
    <dependencies>
        <!-- 声明下面这项外部库或工程依赖。 -->
        <dependency>
            <!-- 声明依赖或工程所属组织标识。 -->
            <groupId>org.springframework.boot</groupId>
            <!-- 声明当前工程、依赖或插件的名称。 -->
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 声明下面这项外部库或工程依赖。 -->
        <dependency>
            <!-- 声明依赖或工程所属组织标识。 -->
            <groupId>org.springframework.boot</groupId>
            <!-- 声明当前工程、依赖或插件的名称。 -->
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- 声明下面这项外部库或工程依赖。 -->
        <dependency>
            <!-- 声明依赖或工程所属组织标识。 -->
            <groupId>org.springframework.boot</groupId>
            <!-- 声明当前工程、依赖或插件的名称。 -->
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- 声明下面这项外部库或工程依赖。 -->
        <dependency>
            <!-- 声明依赖或工程所属组织标识。 -->
            <groupId>org.mybatis.spring.boot</groupId>
            <!-- 声明当前工程、依赖或插件的名称。 -->
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>
        <!-- 声明下面这项外部库或工程依赖。 -->
        <dependency>
            <!-- 声明依赖或工程所属组织标识。 -->
            <groupId>org.postgresql</groupId>
            <!-- 声明当前工程、依赖或插件的名称。 -->
            <artifactId>postgresql</artifactId>
            <!-- 限制依赖在哪些构建或运行阶段可用。 -->
            <scope>runtime</scope>
        </dependency>
        <!-- 声明下面这项外部库或工程依赖。 -->
        <dependency>
            <!-- 声明依赖或工程所属组织标识。 -->
            <groupId>org.springdoc</groupId>
            <!-- 声明当前工程、依赖或插件的名称。 -->
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <!-- 声明下面这项外部库或工程依赖。 -->
        <dependency>
            <!-- 声明依赖或工程所属组织标识。 -->
            <groupId>org.bouncycastle</groupId>
            <!-- 声明当前工程、依赖或插件的名称。 -->
            <artifactId>bcprov-jdk18on</artifactId>
        </dependency>
        <!-- 声明下面这项外部库或工程依赖。 -->
        <dependency>
            <!-- 声明依赖或工程所属组织标识。 -->
            <groupId>org.springframework.boot</groupId>
            <!-- 声明当前工程、依赖或插件的名称。 -->
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- 声明下面这项外部库或工程依赖。 -->
        <dependency>
            <!-- 声明依赖或工程所属组织标识。 -->
            <groupId>org.springframework.security</groupId>
            <!-- 声明当前工程、依赖或插件的名称。 -->
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>
    </dependencies>
</project>
