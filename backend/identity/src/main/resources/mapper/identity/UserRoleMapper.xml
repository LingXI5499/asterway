<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.asterway.identity.mapper.UserRoleMapper">
    <resultMap id="entityMap" type="com.asterway.identity.entity.UserRoleEntity">
        <result column="user_id" property="userId"/>
        <result column="role_id" property="roleId"/>
        <result column="created_at" property="createdAt"/>
        <result column="created_by" property="createdBy"/>
    </resultMap>
    <sql id="columns">
        user_id,
        role_id,
        created_at,
        created_by
    </sql>

    <select id="findIds" resultType="long">
        SELECT role_id FROM identity_user_role WHERE user_id = #{userId} ORDER BY role_id
    </select>
    <delete id="deleteByOwner">
        DELETE FROM identity_user_role WHERE user_id = #{userId}
    </delete>
    <insert id="insert">
        INSERT INTO identity_user_role (user_id, role_id, created_by)
        VALUES (#{userId}, #{roleId}, #{actorId})
    </insert>
</mapper>
